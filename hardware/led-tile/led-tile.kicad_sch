	(text "C1 goes right next to D1."
		(exclude_from_sim no)
		(at 157.48 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "36886399-a3ff-41fd-bf41-ac71dbe96d5f")
	)
	(text "LED tile: one SK6812MINI-E for a backlit panel label.\nD1 is reverse-mounted: it is soldered to the back of the tile and shines\nthrough a hole in the board, so the front face stays flat against the spacer.\nEvery part and pad is on the back of the board."
		(exclude_from_sim no)
		(at 88.9 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4e74184f-2429-4fad-8382-1b6331a7d462")
	)
	(text "DIN needs at least 0.7 x VDD (3.5 V at 5 V). Feed the first tile from the\nmain board's 5 V buffer, never straight from the Teensy's 3.3 V pin.\nTiles chain IN to OUT with three wires: +5V, data, GND."
		(exclude_from_sim no)
		(at 88.9 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d522c569-693f-4bbc-9bf7-ee0c56ea718d")
	)
	(text "Pin numbers: KiCad's symbol numbers D1 as 1 GND, 2 DIN, 3 VDD, 4 DOUT.\nThe OPSCO datasheet (rev 02) numbers the same pins 1 VDD, 2 DOUT, 3 GND, 4 DIN.\nThe symbol and footprint agree with each other and with the real part\n(checked pad by pad against the datasheet, 22 Nov 2026). Go by the pin names."
		(exclude_from_sim no)
		(at 88.9 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eca0cf86-01e4-4d47-b252-c2444e55deb7")
	)
