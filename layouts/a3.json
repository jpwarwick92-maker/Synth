{
  "name": "A3",
  "description": "Condensed layout on a grid: five columns shared by both rows of sections, every section either a row of faders or two rows of knobs and selectors. 17 knobs, 12 rotary selectors, 2 lever switches, 12 faders, 4 push-encoders, 9 buttons, 2.4 inch display.",
  "units": "mm",
  "panel": { "width": 530, "height": 152 },

  "rules": {
    "knobSpacingMin": 22,
    "faderSpacingMin": 17,
    "grid": "The sections sit in two rows of equal height on five shared columns, with the same gap between every pair of neighbours: each upright edge in one row lines up with an edge in the other.",
    "note": "Centre-to-centre distances the layout keeps. Every selector stop has its own tick and label, and no label overlaps another control or label."
  },

  "sizes": {
    "knob": 13,
    "knobLarge": 20,
    "selector": 7.7,
    "encoder": 13,
    "faderCap": [9.5, 4.7],
    "faderSlot": 1.8,
    "toggle": [6, 11]
  },

